{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "BookingSport.Api",
    "Audience": "BookingSport.Client",
    "Secret": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "RefreshCookieName": "bookingSport.refresh",
    "CookieSecure": true,
    "CookieSameSite": "Lax"
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardEnabled": false,
    "WorkerCount": 0
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "FromName": "Booking Sport",
    "FromAddress": "",
    "UseSsl": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ApiLogging": {
    "EnableRequestBodyLogging": true,
    "MaxBodySizeBytes": 16384,
    "ExcludedPaths": [
      "/api/auth/login",
      "/api/auth/register",
      "/api/auth/refresh",
      "/api/auth/logout"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "Logging": {
    "File": {
      "Enabled": true,
      "FolderPath": "logs",
      "FileNamePattern": "booking-sport-api-.log",
      "RetainedFileCountLimit": 14
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
