POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
POSTGRES_PORT=<host-port>

ConnectionStrings__DefaultConnection=Host=<host>;Port=<port>;Database=<database-name>;Username=<database-user>;Password=<database-password>

Jwt__Issuer=<jwt-issuer>
Jwt__Audience=<jwt-audience>
Jwt__Secret=<jwt-secret>
Jwt__AccessTokenMinutes=15

Auth__RefreshTokenDays=14
Auth__RefreshCookieName=bookingSport.refresh
Auth__CookieSecure=true
Auth__CookieSameSite=Lax
